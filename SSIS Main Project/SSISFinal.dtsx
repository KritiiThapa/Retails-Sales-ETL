                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.StoreID,
    s.StoreName,
    s.City,
    s.State,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.StoreID ORDER BY s.LoadDate) AS RowNum,
    CASE WHEN ds.StoreID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM dbo.StgStore s
LEFT JOIN dbo.DimStore ds ON ds.StoreID = s.StoreID</property>
